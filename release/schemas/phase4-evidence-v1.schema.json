{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Payhon/boxd/release/schemas/phase4-evidence-v1.schema.json",
  "title": "boxd Phase 4 evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suite",
    "commit",
    "platform",
    "toolchain",
    "inputs",
    "cases",
    "artifacts",
    "external_requirements",
    "secret_scan",
    "summary"
  ],
  "properties": {
    "schema": {"const": "boxd-phase4-evidence-v1"},
    "suite": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "virtualization"],
      "properties": {
        "os": {"enum": ["linux", "macos"]},
        "arch": {"enum": ["x86_64", "aarch64"]},
        "virtualization": {"enum": ["none", "kvm", "hvf"]}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_-]{0,31}$": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "inputs": {"$ref": "#/$defs/hashRecords"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expected", "observed", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{0,191}$"},
          "expected": {"type": "string", "minLength": 1, "maxLength": 2048},
          "observed": {"type": "string", "minLength": 1, "maxLength": 2048},
          "status": {"enum": ["pass", "fail", "blocked"]},
          "artifact_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/relativePath"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "external_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "status": {"enum": ["satisfied", "blocked"]},
          "detail": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    },
    "secret_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scanner", "findings"],
      "properties": {
        "status": {"enum": ["pass", "fail", "blocked"]},
        "scanner": {"type": "string", "minLength": 1, "maxLength": 256},
        "findings": {"type": "integer", "minimum": 0}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passed", "failed", "blocked", "total"],
      "properties": {
        "status": {"enum": ["pass", "fail", "blocked"]},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/+@=-]+$"
    },
    "hashRecords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  }
}
