<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.payhon.boxd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/boxd</string>
    <string>serve</string>
    <string>-c</string>
    <string>/Library/Application Support/boxd/boxd.toml</string>
  </array>
  <key>UserName</key>
  <string>boxd</string>
  <key>GroupName</key>
  <string>boxd</string>
  <key>WorkingDirectory</key>
  <string>/Library/Application Support/boxd</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>1048576</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/var/log/boxd/boxd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/boxd/boxd.stderr.log</string>
</dict>
</plist>
